{
    "name": "@leetcode/conformance",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "LeetCode 完备性测试与 Valkyrie 对比基准（本地 sibling valkyrie.rs）",
    "exports": {
        ".": "./src/index.ts",
        "./bench": "./src/runner/bench-all.ts",
        "./catalog": "./src/catalog.generated.ts"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "node --import tsx src/runner/bench-all.ts",
        "bench:python": "node --import tsx src/runner/bench-python.ts",
        "bench:typescript": "node --import tsx src/runner/bench-typescript.ts",
        "bench:typescript-bun": "node --import tsx src/runner/bench-typescript-bun.ts",
        "bench:valkyrie": "node --import tsx src/runner/bench-valkyrie.ts",
        "bench:wolfram-sxo": "node --import tsx src/runner/bench-wolfram-sxo.ts",
        "bench:matlab-sxo": "node --import tsx src/runner/bench-matlab-sxo.ts",
        "rebuild:bun": "pnpm rebuild bun"
    },
    "optionalDependencies": {
        "@sxo/mathematica": "^0.0.6",
        "@sxo/matlab": "^0.0.6"
    },
    "devDependencies": {
        "bun": "^1.2.0",
        "@valkyrie-language/vcc": "link:../../../valkyrie.rs/projects/packages/vcc",
        "@types/node": "^22.10.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^4.1.11"
    }
}
