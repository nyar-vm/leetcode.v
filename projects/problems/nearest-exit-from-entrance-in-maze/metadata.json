{
    "id": "nearest-exit-from-entrance-in-maze",
    "questionId": 1926,
    "difficulty": "Medium",
    "tags": ["Breadth-First Search", "Array", "Matrix"],
    "tests": [
        {
            "args": {
                "maze": [[".", "+"]],
                "entrance": [0, 0]
            },
            "expected": -1
        },
        {
            "args": {
                "maze": [[".", ".", "."], [".", ".", "."], [".", ".", "."]],
                "entrance": [0, 1]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [[".", ".", ".", "."], [".", ".", ".", "."], [".", ".", ".", "."], [".", ".", ".", "."]],
                "entrance": [0, 0]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [[".", ".", "."], [".", ".", "."], [".", ".", "."]],
                "entrance": [2, 2]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [["+)", "+)", "+"], [".", ".", "."], ["+)", "+)", "+"]],
                "entrance": [1, 0]
            },
            "expected": 2
        },
        {
            "args": {
                "maze": [["+)", "+)", "."], [".", ".", ".", "+"], ["+)", "+)", "+)", "."]],
                "entrance": [1, 2]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [["+", ".", "+"], [".", ".", "."], ["+", ".", "+"]],
                "entrance": [1, 1]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [[".", ".", "+", "."], [".", ".", ".", "."], [".", ".", ".", "."], [".", ".", ".", "."]],
                "entrance": [0, 3]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [[".", ".", ".", "."], [".", "+", ".", "."], [".", ".", ".", "."], [".", ".", ".", "."]],
                "entrance": [1, 1]
            },
            "expected": 1
        },
        {
            "args": {
                "maze": [[".", ".", "."], [".", ".", "."], [".", ".", "."]],
                "entrance": [1, 1]
            },
            "expected": 1
        }
    ],
    "invoke": {
        "python": "Solution().nearestExit",
        "typescript": "Solution().nearestExit"
    }
}
