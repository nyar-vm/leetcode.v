{
    "id": "plates-between-candles",
    "questionId": 2055,
    "difficulty": "Medium",
    "tags": ["Array", "String", "Binary Search", "Prefix Sum"],
    "tests": [
        {
            "args": {
                "s": "**|**|***|",
                "queries": [[2, 5], [5, 9]]
            },
            "expected": [2, 3]
        },
        {
            "args": {
                "s": "***||***",
                "queries": [[0, 5], [2, 4]]
            },
            "expected": [0, 0]
        },
        {
            "args": {
                "s": "*|*|*|*|*|*|*|",
                "queries": [[0, 7], [1, 6], [2, 5]]
            },
            "expected": [3, 2, 1]
        },
        {
            "args": {
                "s": "|||***|||",
                "queries": [[0, 8], [1, 7], [2, 6]]
            },
            "expected": [3, 3, 3]
        },
        {
            "args": {
                "s": "||*|*|*|*|*|*|",
                "queries": [[0, 10], [1, 9], [2, 8], [3, 7]]
            },
            "expected": [4, 4, 2, 2]
        },
        {
            "args": {
                "s": "|||****|****|****||",
                "queries": [[0, 10], [5, 15], [1, 4]]
            },
            "expected": [4, 4, 0]
        },
        {
            "args": {
                "s": "*|*|*|*|*|",
                "queries": [[0, 5], [1, 4]]
            },
            "expected": [2, 1]
        },
        {
            "args": {
                "s": "|*|*|*|*|*|*|*|*|*|*|",
                "queries": [[0, 10], [1, 9], [2, 8], [3, 7]]
            },
            "expected": [5, 3, 3, 1]
        },
        {
            "args": {
                "s": "|||*****|||",
                "queries": [[0, 2], [3, 8], [7, 10]]
            },
            "expected": [0, 0, 0]
        },
        {
            "args": {
                "s": "*|*|*|*|*|*|*|*|*|*|*|",
                "queries": [[0, 11], [1, 10], [2, 9], [3, 8]]
            },
            "expected": [5, 4, 3, 2]
        },
        {
            "args": {
                "s": "*|*|*|*|*|*|*|*|*|*|",
                "queries": [[0, 10], [1, 9], [2, 8], [3, 7]]
            },
            "expected": [4, 4, 2, 2]
        },
        {
            "args": {
                "s": "***|**|*****|**||**|*",
                "queries": [[1, 17], [4, 5], [14, 17], [5, 11], [15, 16]]
            },
            "expected": [9, 0, 0, 0, 0]
        },
        {
            "args": {
                "s": "***||****|**|",
                "queries": [[0, 4], [5, 8], [9, 11]]
            },
            "expected": [0, 0, 0]
        }
    ],
    "invoke": {
        "python": "Solution().platesBetweenCandles",
        "typescript": "Solution().platesBetweenCandles"
    }
}
