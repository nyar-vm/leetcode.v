{
    "name": "leetcode-v",
    "private": true,
    "version": "0.1.0",
    "description": "LeetCode Valkyrie 完备性测试与 TS vs Wasm 对比看板",
    "scripts": {
        "fmt": "node scripts/format.mjs",
        "fmt:check": "node scripts/format.mjs --check",
        "reword:lint": "node scripts/reword.mjs --lint-log --base origin/dev",
        "link:valkyrie": "node scripts/link-valkyrie.mjs",
        "test:problems": "pnpm --filter @leetcode/conformance test",
        "bench": "pnpm --filter @leetcode/conformance run bench",
        "bench:python": "pnpm --filter @leetcode/conformance run bench:python",
        "bench:typescript": "pnpm --filter @leetcode/conformance run bench:typescript",
        "bench:valkyrie": "pnpm --filter @leetcode/conformance run bench:valkyrie",
        "dashboard": "pnpm --filter @leetcode/bench-dashboard run dev"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "pnpm": "^10.18.3"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.18.3"
}
